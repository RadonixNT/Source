// Lower the loader. Result 0: confirmed/delay elapsed; 1: TP0 active;
// 2: output unassigned; 3: down-sensor timeout; 4: TP1 interrupted.
// Sensor feedback replaces delay. This stage belongs to the TP1 Load route.
INTEGER Delay := 0;
IF NOT TP1.Running OR TP1.Stopping OR TP1.StopCommand THEN
    LoaderDown := FALSE;
    END_FUNCTION(Result := 4);
END_IF;
IF TP0.ProgramActive THEN
    LoaderDown := FALSE;
    END_FUNCTION(Result := 1);
END_IF;
IF NOT ASSIGNED(LoaderDown) THEN
    END_FUNCTION(Result := 2);
END_IF;
IF SF.FirstScan THEN Delay := LoaderDownTime; END_IF;
LoaderDown := TRUE;
IF ASSIGNED(LoaderDownSensor) THEN
    IF LoaderDownSensor THEN END_FUNCTION(Result := 0); END_IF;
    IF SF.Time >= 3 * Delay THEN
        LoaderDown := FALSE;
        END_FUNCTION(Result := 3);
    END_IF;
ELSIF SF.Time >= Delay THEN
    END_FUNCTION(Result := 0);
END_IF;
