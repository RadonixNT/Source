IF SF.FirstScan THEN
Stage := 0; Phase := 0; Result := 0; TimeoutMs := Controller.HomeTimeout * 1000;
XPosition := X.HomePosition; XDisplace := X.HomeDisplace;
XVelocity := X.HomeVelocity; XReturn := X.HomeReturnVelocity; XDirection := X.HomeDirection;
XSeen := FALSE; XReleased := FALSE;
IF XDirection <> -1 AND XDirection <> 1 THEN Result := 2; END_IF;
END_IF;
SearchTimeout(TYPE := TON, IN := (Phase = 1 OR Phase = 2) AND Result = 0, PT := TimeoutMs);
ReleaseTimeout(TYPE := TON, IN := (Phase = 3 OR Phase = 4) AND Result = 0, PT := TimeoutMs);
CouplingTimeout(TYPE := TON, IN := Phase = 0 AND Result = 0, PT := 60000);
IF SearchTimeout.Q OR ReleaseTimeout.Q THEN Result := 1; END_IF;
IF CouplingTimeout.Q THEN Result := 3; END_IF;
IF Result <> 0 THEN
AXES_STOP(X);
IF X.Stopped THEN
