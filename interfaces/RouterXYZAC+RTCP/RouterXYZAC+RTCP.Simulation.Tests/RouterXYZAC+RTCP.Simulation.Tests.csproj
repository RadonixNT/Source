<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>RouterXYZACRTCP.Simulation.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RouterXYZAC+RTCP.Simulation.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RouterXYZAC+RTCP\RouterXYZAC+RTCP.csproj" />
    <AssemblyMetadata Include="InterfaceOutputDirectory" Value="$(MSBuildProjectDirectory)\..\RouterXYZAC+RTCP\bin\$(Configuration)\$(TargetFramework)" />
    <AssemblyMetadata Include="BinaryReferenceRoot" Value="$(MSBuildProjectDirectory)\..\Runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- Matches the preparation integration excluded from the application. -->
    <Compile Remove="PcReadinessTests.cs" />
  </ItemGroup>
  <Import Project="..\DeliveryReferences.props" />
</Project>