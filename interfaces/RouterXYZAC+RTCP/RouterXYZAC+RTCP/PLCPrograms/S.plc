// S owns the retained speed setpoint; RUN/direction never clear or restore it.
REAL Speed;
IF MaximumSpindleSpeed > 0.0 THEN
    Speed := ProgramArg / MaximumSpindleSpeed;
ELSE
    Speed := 0.0;
END_IF;
IF Speed < 0.0 THEN
    Speed := 0.0;
ELSIF Speed > 1.0 THEN
    Speed := 1.0;
END_IF;
SpindleSpeed := Speed;
END_FUNCTION(Result := 0);
